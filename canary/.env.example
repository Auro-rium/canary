# Backend API URL (where the Express BFF listens)
VITE_API_URL="http://localhost:8000"

# Bearer token sent with every API request — must match API_SECRET_KEY on the server
VITE_API_TOKEN="your-api-token-here"

# Set to "true" to show a demo mode banner (production builds should leave this unset or false)
VITE_DEMO_MODE="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
