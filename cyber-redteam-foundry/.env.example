# AWS Bedrock
AWS_REGION="us-east-1"
# AWS credentials are resolved via the standard boto3 chain (env vars,
# shared ~/.aws/config & credentials, or an instance/role profile). For
# local dev you may set them explicitly:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""
# IAM principal needs bedrock:InvokeModel on the model/inference-profile ARNs.

# API Authentication
# Bearer token required on every API request. Must match the frontend's
# VITE_API_TOKEN. If unset, the API fails closed (refuses all requests).
API_SECRET_KEY="change-me"

# Authorization scope
# Comma-separated list of target_ids a run may be created against
# ("attack only what you're allowed to"). Empty = no allowlist enforced.
ALLOWED_TARGETS="http://host.docker.internal:9000/chat,http://localhost:9000/chat"

# Target Configuration
TARGET_MODE="http"
TARGET_ENDPOINT=""
TARGET_API_KEY=""

# Logging
LOG_LEVEL="INFO"
LOG_FILE="runs/cyber_redteam.log"

# Database
DB_PATH="runs/redteam.db"

# Report Output
REPORT_OUTPUT_DIR="reports"
REPORT_FORMAT="markdown"  # markdown | json | both

# Run Configuration
MAX_RETRIES=3
MAX_CONCURRENT_RUNS=3
TIMEOUT_SECONDS=30
DETERMINISTIC_SEED=42
