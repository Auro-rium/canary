# NVIDIA NIM (server-side only)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# API Authentication
# Server-side bearer token for dashboard proxy and administrative API calls.
# Never expose this value as a VITE_* variable.
API_SECRET_KEY="change-me"
# HMAC pepper for hashing project-scoped CI tokens. Rotate with token reissue.
TOKEN_PEPPER="change-this-long-random-value"

# Authorization scope
# Comma-separated list of target_ids a run may be created against
# ("attack only what you're allowed to"). Empty = no allowlist enforced.
ALLOWED_TARGETS="http://host.docker.internal:9000/chat,http://localhost:9000/chat"
# Set true only for the isolated local Docker demo. Never enable it on AWS.
ALLOW_PRIVATE_TARGETS=false

# Target Configuration
TARGET_ENDPOINT="https://preview.example.com/chat"  # verified HTTP(S) agent endpoint
TARGET_API_KEY=""

# Logging
LOG_LEVEL="INFO"
LOG_FILE="runs/cyber_redteam.log"

# Database
# Hosted mode: PostgreSQL URL (for example an AWS RDS private endpoint).
# Leave empty for local SQLite.
DATABASE_URL=""
DB_PATH="runs/redteam.db"

# Durable release execution. Keep `thread` for local development; AWS ECS
# runs the API with `rq` and a separate canary-worker service.
RELEASE_EXECUTION_MODE="thread"
REDIS_URL="redis://localhost:6379/0"
RELEASE_QUEUE_NAME="canary-releases"
RELEASE_JOB_TIMEOUT_SECONDS=3600

# Report Output
REPORT_OUTPUT_DIR="reports"
REPORT_FORMAT="markdown"  # markdown | json | both

# Run Configuration
MAX_RETRIES=3
MAX_CONCURRENT_RUNS=3
TIMEOUT_SECONDS=30
DETERMINISTIC_SEED=42
