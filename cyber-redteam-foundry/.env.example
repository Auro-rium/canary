# Azure AI Foundry Project Configuration
AZURE_PROJECT_CONNECTION_STRING=""
AZURE_SUBSCRIPTION_ID=""
AZURE_RESOURCE_GROUP=""
AZURE_PROJECT_NAME=""

# Azure Credentials (one of these required)
AZURE_USE_DEFAULT_CREDENTIAL=true
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION="2024-02-15-preview"
AZURE_OPENAI_DEPLOYMENT=""

# Target Configuration
TARGET_MODE="sandbox"  # sandbox | foundry_agent
TARGET_ENDPOINT=""
TARGET_API_KEY=""

# Local Red Teaming
LOCAL_REDTEAM_ENABLED=false

# Logging
LOG_LEVEL="INFO"
LOG_FILE="runs/cyber_redteam.log"

# Database
DB_PATH="runs/redteam.db"

# Report Output
REPORT_OUTPUT_DIR="reports"
REPORT_FORMAT="markdown"  # markdown | json | both

# Run Configuration
MAX_RETRIES=3
TIMEOUT_SECONDS=30
DETERMINISTIC_SEED=42
