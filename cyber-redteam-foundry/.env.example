# Backboard.io LLM gateway (required; the app fails closed without a key)
BACKBOARD_API_KEY=""
BACKBOARD_BASE_URL="https://app.backboard.io/api"
BACKBOARD_TIMEOUT_SECONDS=60
# Defaults for any role not configured in configs/models.yaml
BACKBOARD_LLM_PROVIDER="openai"
BACKBOARD_MODEL_NAME="gpt-4o"
# Per-role overrides (roles: PLANNER, STRATEGIST, ATTACKER, EVALUATOR, JUDGE, REPORTER)
# BACKBOARD_ATTACKER_PROVIDER="openai"
# BACKBOARD_ATTACKER_MODEL_NAME="gpt-4o"

# API Authentication
# Bearer token required on every API request. Must match the frontend's
# VITE_API_TOKEN. If unset, the API fails closed (refuses all requests).
API_SECRET_KEY="change-me"

# Authorization scope
# Comma-separated list of target_ids a run may be created against
# ("attack only what you're allowed to"). Empty = no allowlist enforced.
ALLOWED_TARGETS="http://host.docker.internal:9000/chat,http://localhost:9000/chat"

# Target Configuration
# The legacy v1 flow only contacts a REGISTERED, ownership-VERIFIED target:
# TARGET_ENDPOINT must be the exact endpoint (or target id) of one, else it refuses.
TARGET_MODE="http"
TARGET_ENDPOINT=""
TARGET_API_KEY=""

# Logging
LOG_LEVEL="INFO"
LOG_FILE="runs/cyber_redteam.log"

# Database
DB_PATH="runs/redteam.db"

# Report Output
REPORT_OUTPUT_DIR="reports"
REPORT_FORMAT="markdown"  # markdown | json | both

# Run Configuration
MAX_RETRIES=3
MAX_CONCURRENT_RUNS=3
TIMEOUT_SECONDS=30
DETERMINISTIC_SEED=42

# --- Worker: turn planner (WP4) -------------------------------------------------
# "package.module:callable" resolving to a planner factory. UNSET = fail closed:
# every campaign fails with "no planner configured". There is deliberately no default.
#   cyberredteam.planners.worker:scripted  benign ScriptedPlanner smoke packs from
#                                          PLANNER_PACKS_DIR (default <project>/packs)
#   cyberredteam.planners.worker:llm       LLM planner; refuses to run until the
#                                          security owner supplies prompts/planner.md
#                                          and a scope classifier
# PLANNER_FACTORY=cyberredteam.planners.worker:scripted
# PLANNER_PACKS_DIR=packs
# PLANNER_PACK_SET=smoke                    # smoke (default) | attacks | all; used when PLANNER_PACKS_DIR is unset
# PLANNER_MAX_MESSAGE_CHARS=4000            # >= 1
# PLANNER_TRANSCRIPT_CHARS_PER_TURN=2000    # >= 1
# PLANNER_USD_PER_1K_INPUT_TOKENS=0.01      # > 0
# PLANNER_USD_PER_1K_OUTPUT_TOKENS=0.03     # > 0
# Judge spend: the judge's token usage, when the backend REPORTS it, is charged to the
# campaign budget at these rates and so counts toward max_llm_cost_usd. If the backend
# reports no usage, judge spend is NOT bounded by max_llm_cost_usd (only by
# conversations x CANARY_JUDGE_VOTES).
# JUDGE_USD_PER_1K_INPUT_TOKENS=0.01        # > 0
# JUDGE_USD_PER_1K_OUTPUT_TOKENS=0.03       # > 0

# --- Worker: per-target safety config (WP5 monitors) -----------------------------
# Directory with <target_id>.yaml and/or default.yaml (canary_values, forbidden_tools;
# see configs/demo_target.yaml). Unset = no canaries and no forbidden tools.
# TARGET_SAFETY_DIR=configs/targets

# --- Judge (WP5) -----------------------------------------------------------------
# Odd, >= 3. Without BACKBOARD_API_KEY the judge is unavailable and verdicts are
# "inconclusive" (never "safe").
# CANARY_JUDGE_VOTES=3

# --- Observability (WP11): no key = no-op ----------------------------------------
# WANDB_API_KEY=
# WANDB_ENTITY=
# WANDB_PROJECT=canary
# WANDB_MODE=online                         # online | offline | disabled
# WANDB_EXPORT_RAW_EVIDENCE=false           # raw text only if also environment=staging
# CANARY_OPS_WEBHOOK_URL=

# --- Deployment / auth (WP8) ------------------------------------------------------
# Anything other than dev/test is treated as PRODUCTION (OIDC needs PUBLIC_BASE_URL and
# Secure session cookies). Set CANARY_ENV=dev only for local http development.
# CANARY_ENV=production
# Public origin of the API as the browser sees it; builds the OIDC redirect_uri
# (<base>/api/v2/auth/callback/<provider>). Required in production.
# PUBLIC_BASE_URL=https://canary.example.com
# Secure cookies need HTTPS; set false only for local http development.
# SESSION_COOKIE_SECURE=true
# Platform operators (user ids or emails, comma separated); only they may flip the
# global kill switch.
# CANARY_PLATFORM_ADMINS=ops@example.com
