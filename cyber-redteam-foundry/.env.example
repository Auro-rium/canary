# Backboard.io (https://backboard.io) — powers the attacker, evaluator and reporter
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_LLM_PROVIDER=openai
BACKBOARD_MODEL_NAME=gpt-4o
BACKBOARD_TIMEOUT_SECONDS=60

# API authentication. Bearer token required on every API request; must match the
# dashboard's proxy token. If unset, the API fails closed (refuses all requests).
API_SECRET_KEY=change-me

# Authorization scope: comma-separated endpoints a campaign may attack.
# Only list agents you own or are explicitly authorized to test.
ALLOWED_TARGETS=https://your-agent.example.com/chat
REQUIRE_TARGET_ALLOWLIST=true

# Default target (optional)
TARGET_MODE=http
TARGET_ENDPOINT=
TARGET_API_KEY=

LOG_LEVEL=INFO
LOG_FILE=runs/cyber_redteam.log
DB_PATH=runs/redteam.db
REPORT_OUTPUT_DIR=reports
REPORT_FORMAT=both

MAX_RETRIES=3
MAX_CONCURRENT_RUNS=3
TIMEOUT_SECONDS=30
DETERMINISTIC_SEED=42
